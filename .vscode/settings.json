{
    // Visuals and UI
    "editor.bracketPairColorization.enabled": true,
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.fontFamily": "JetBrainsMono Nerd Font",
    "editor.fontLigatures": true,
    "editor.fontSize": 14,
    "editor.guides.bracketPairs": true,
    "editor.guides.bracketPairsHorizontal": true,
    "editor.guides.highlightActiveBracketPair": true,
    "editor.hover.delay": 1000,
    "editor.minimap.enabled": false,
    "editor.rulers": [
        100
    ],
    "editor.stickyScroll.enabled": false,
    "terminal.integrated.fontSize": 14,
    "window.zoomLevel": 0,
    // File and workspace management
    "explorer.autoReveal": true,
    "explorer.compactFolders": false,
    "editor.formatOnSave": true,
    "files.autoSave": "onFocusChange",
    "files.trimTrailingWhitespace": true,
    // Icon theme settings
    "files.associations": {
        "**/*.json5": "json5",
    },
    "material-icon-theme.files.associations": {
        "README.md": "document",
        "*.gotmpl": "go",
        "release.yaml": "helm",
        "namespace.yaml": "kubernetes",
        "helmfile.yaml": "helm",
        "source.yaml": "parcel",
        "secrets.yaml": "key",
        "ks.yaml": "rocket",
        "kustomization.yaml": "kubernetes",
    },
    "material-icon-theme.folders.associations": {
        "bootstrap": "seeders",
        "talos": "linux",
        "gaming": "console",
        "envoy-gateway-system": "context",
        "cert-manager": "license",
        "flux-system": "generator",
        "kube-system": "controller",
        "productivity": "tasks",
        "security": "guard",
        "storage": "archive",
        "external-secrets": "secure",
        "observability": "review",
        "rook-ceph": "aws",
        "default": "home",
        "deployment": "azure-pipelines",
        "platform": "server",
        "helmfile": "helm",
        "ai": "gemini-ai",
        "lifestyle": "java",
    },
    "workbench.productIconTheme": "icons-carbon",
    // Language configuration
    "yaml.schemaStore.enable": true,
    "yaml.schemas": {
        "kubernetes": "./kubernetes/**/*.yaml"
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[json5]": {
        "editor.defaultFormatter": "BlueGlassBlock.better-json5"
    }
}